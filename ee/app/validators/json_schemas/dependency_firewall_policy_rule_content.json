{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Dependency firewall policy rule content",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "license",
        "vulnerability",
        "malicious"
      ],
      "description": "Specifies the type of the rule"
    },
    "denied": {
      "type": "array",
      "description": "Entries that are denied. For 'license' rules, list of license names. For 'vulnerability' rules, a single severity threshold. For 'malicious' rules, if the package has been flagged as malicious. Mutually exclusive with 'allowed'.",
      "minItems": 1,
      "maxItems": 1000
    },
    "allowed": {
      "type": "array",
      "description": "Entries that are allowed. For 'license' rules, list of license names. For 'vulnerability' rules, a single severity threshold. Mutually exclusive with 'denied'.",
      "minItems": 1,
      "maxItems": 1000
    },
    "exceptions": {
      "type": "array",
      "description": "List of exceptions that bypass this rule. Each entry can specify either a package URL (PURL) or a vulnerability identifier (e.g. CVE).",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "purl": {
            "type": "string",
            "pattern": "^pkg:",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Package URL (PURL) format for the exception"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Vulnerability identifier (e.g. CVE) for the exception"
          }
        },
        "anyOf": [
          {
            "required": [
              "purl"
            ]
          },
          {
            "required": [
              "id"
            ]
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "type",
        "denied"
      ]
    },
    {
      "required": [
        "type",
        "allowed"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "license"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "denied": {
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "description": "The name of the license (SPDX human-readable name)"
                }
              },
              "additionalProperties": false
            }
          },
          "allowed": {
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "description": "The name of the license (SPDX human-readable name)"
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "vulnerability"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "denied": {
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": [
                "severity"
              ],
              "properties": {
                "severity": {
                  "type": "string",
                  "enum": [
                    "critical",
                    "high",
                    "medium",
                    "low",
                    "info",
                    "unknown"
                  ],
                  "description": "Severity threshold. Vulnerabilities at or above this severity are denied."
                }
              },
              "additionalProperties": false
            }
          },
          "allowed": {
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": [
                "severity"
              ],
              "properties": {
                "severity": {
                  "type": "string",
                  "enum": [
                    "critical",
                    "high",
                    "medium",
                    "low",
                    "info",
                    "unknown"
                  ],
                  "description": "Severity threshold. Vulnerabilities at or below this severity are allowed."
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "malicious"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "denied"
        ],
        "not": {
          "required": [
            "allowed"
          ]
        },
        "properties": {
          "denied": {
            "items": {
              "type": "object",
              "required": [
                "is_malicious"
              ],
              "properties": {
                "is_malicious": {
                  "type": "boolean",
                  "enum": [
                    true
                  ],
                  "description": "Whether the package is flagged by the malicious packages data feed."
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
